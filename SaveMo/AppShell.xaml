<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SaveMo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SaveMo.Views"
    Title="SaveMo"
    FlyoutBehavior="Flyout">

    <!-- Define shell routes for navigation -->
    <ShellContent
        Title="Dashboard"
        Icon="home.png"
        ContentTemplate="{DataTemplate local:DashboardPage}"
        Route="dashboard" />

    <ShellContent
        Title="Transactions"
        Icon="list.png"
        ContentTemplate="{DataTemplate local:TransactionsPage}"
        Route="transactions" />

    <ShellContent
        Title="Budgets"
        Icon="budget.png"
        ContentTemplate="{DataTemplate local:BudgetsPage}"
        Route="budgets" />

    <ShellContent
        Title="Reports"
        Icon="chart.png"
        ContentTemplate="{DataTemplate local:ReportsPage}"
        Route="reports" />

    <ShellContent
        Title="Pre-Purchase"
        Icon="analyze.png"
        ContentTemplate="{DataTemplate local:PrePurchaseAnalyzerPage}"
        Route="analyzer" />

    <!-- Flyout Footer with Theme Toggle -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16" Spacing="8">
            <BoxView HeightRequest="1" Color="{DynamicResource DynamicCardBorder}" />
            <Button
                x:Name="ThemeToggleButton"
                Text="☀️ Light Mode"
                Clicked="OnThemeToggleClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                Padding="12"
                FontSize="14" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
