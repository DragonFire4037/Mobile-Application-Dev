<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="SaveMo.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SaveMo.Views"
    Title="Reports"
    BackgroundColor="{DynamicResource DynamicBackground}">

    <VerticalStackLayout Padding="12" Spacing="16" BackgroundColor="{DynamicResource DynamicBackground}">
        <!-- Header -->
            <Label Text="Reports" Style="{StaticResource Heading1}" />

            <!-- Month Navigation -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button
                    Text="←"
                    Command="{Binding PreviousMonthCommand}"
                    WidthRequest="40"
                    HeightRequest="40" />
                <Label
                    Text="{Binding SelectedMonth, StringFormat='Month: {0:00}'}"
                    VerticalOptions="Center"
                    FontSize="14" />
                <Label
                    Text="{Binding SelectedYear}"
                    VerticalOptions="Center"
                    FontSize="14" />
                <Button
                    Text="→"
                    Command="{Binding NextMonthCommand}"
                    WidthRequest="40"
                    HeightRequest="40" />
            </HorizontalStackLayout>

            <!-- Monthly Summary -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Monthly Summary" Style="{StaticResource Heading2}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Total Income" Style="{StaticResource Caption}" />
                            <Label
                                Text="{Binding MonthlyReport.TotalIncome, StringFormat='${0:F2}'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Success}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Total Expense" Style="{StaticResource Caption}" />
                            <Label
                                Text="{Binding MonthlyReport.TotalExpense, StringFormat='${0:F2}'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Error}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Net Amount" Style="{StaticResource Caption}" />
                        <Label
                            Text="{Binding MonthlyReport.NetAmount, StringFormat='${0:F2}'}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Category Breakdown -->
            <Label Text="Spending by Category" Style="{StaticResource Heading2}" />
            <CollectionView ItemsSource="{Binding CategoryBreakdown}" HeightRequest="250">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SubtleCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label
                                        Text="{Binding Category}"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextDark}"
                                        HorizontalOptions="Fill" />
                                    <Label
                                        Text="{Binding Percentage, StringFormat='{0:F1}%'}"
                                        FontSize="12"
                                        TextColor="{StaticResource Accent}" />
                                </HorizontalStackLayout>
                                <ProgressBar Progress="{Binding Percentage, Converter={StaticResource PercentageConverter}}" />
                                <Label
                                    Text="{Binding Amount, StringFormat='${0:F2}'}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Budget vs Actual -->
            <Label Text="Budget vs Actual" Style="{StaticResource Heading2}" />
            <CollectionView ItemsSource="{Binding BudgetVsActual}" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SubtleCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{Binding Category}"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />
                                <ProgressBar Progress="{Binding Percentage, Converter={StaticResource PercentageConverter}}" />
                                <Label
                                    Text="{Binding Amount, StringFormat='Actual: ${0:F2}'}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Spending Trends -->
            <Label Text="6-Month Trend" Style="{StaticResource Heading2}" />
            <Border Style="{StaticResource CardStyle}">
                <CollectionView ItemsSource="{Binding SpendingTrends.SpendingTrends}" HeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="4" Padding="12">
                                <Label
                                    Text="{Binding Month}"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Income" FontSize="11" />
                                        <Label
                                            Text="{Binding Income, StringFormat='${0:F2}'}"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            TextColor="{StaticResource Success}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Expense" FontSize="11" />
                                        <Label
                                            Text="{Binding Expense, StringFormat='${0:F2}'}"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            TextColor="{StaticResource Error}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
</views:BasePage>
