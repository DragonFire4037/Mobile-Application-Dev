<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- SaveMo Industrial Revolution Palette: Brown base, brass accents, silver highlights -->

    <!-- Primary: Deep Brown -->
    <Color x:Key="Primary">#3E2723</Color>
    <Color x:Key="PrimaryDark">#1B0000</Color>
    <Color x:Key="PrimaryLight">#5D4037</Color>
    <Color x:Key="PrimaryDarkText">#F5DEB3</Color>

    <!-- Secondary: Medium Brown -->
    <Color x:Key="Secondary">#795548</Color>
    <Color x:Key="SecondaryLight">#A1887F</Color>
    <Color x:Key="SecondaryDarkText">#FFF8DC</Color>

    <!-- Accent: Brass Gold -->
    <Color x:Key="Accent">#D4AF37</Color>
    <Color x:Key="AccentLight">#E8C547</Color>
    <Color x:Key="AccentDark">#AA8C2C</Color>

    <!-- Tertiary: Silver -->
    <Color x:Key="Tertiary">#C0C0C0</Color>
    <Color x:Key="TertiaryLight">#E8E8E8</Color>
    <Color x:Key="TertiaryDark">#808080</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#6BCB77</Color>
    <Color x:Key="Warning">#FFD93D</Color>
    <Color x:Key="Error">#FF6B6B</Color>
    <Color x:Key="Info">#4D96FF</Color>

    <!-- Text and UI Basics -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="TextDark">#2C2C2C</Color>
    <Color x:Key="TextLight">#F5F5F5</Color>
    <Color x:Key="TextSecondary">#666666</Color>

    <!-- Grayscale -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#E8E8E8</Color>
    <Color x:Key="Gray300">#D0D0D0</Color>
    <Color x:Key="Gray400">#A8A8A8</Color>
    <Color x:Key="Gray500">#808080</Color>
    <Color x:Key="Gray600">#606060</Color>
    <Color x:Key="Gray700">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes for XAML -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    
        <!-- Day Theme (Light) - Default -->
    <Color x:Key="ThemePrimaryDay">#3E2723</Color>
    <Color x:Key="ThemeSecondaryDay">#795548</Color>
    <Color x:Key="ThemeAccentDay">#D4AF37</Color>
    <Color x:Key="ThemeBackgroundDay">#FFFFFF</Color>
    <Color x:Key="ThemeTextDay">#2C2C2C</Color>
    <Color x:Key="ThemeCardBackgroundDay">#F5F5F5</Color>
    <Color x:Key="ThemeCardBorderDay">#E8E8E8</Color>

    <!-- Night Theme (Dark) -->
    <Color x:Key="ThemePrimaryNight">#1B0000</Color>
    <Color x:Key="ThemeSecondaryNight">#5D4037</Color>
    <Color x:Key="ThemeAccentNight">#E8C547</Color>
    <Color x:Key="ThemeBackgroundNight">#141414</Color>
    <Color x:Key="ThemeTextNight">#F5F5F5</Color>
    <Color x:Key="ThemeCardBackgroundNight">#212121</Color>
    <Color x:Key="ThemeCardBorderNight">#404040</Color>

    <!-- Dynamic Resources - Theme Colors (switched at runtime) -->
    <Color x:Key="DynamicPrimary">#3E2723</Color>
    <Color x:Key="DynamicSecondary">#795548</Color>
    <Color x:Key="DynamicAccent">#D4AF37</Color>
    <Color x:Key="DynamicBackground">#FFFFFF</Color>
    <Color x:Key="DynamicText">#2C2C2C</Color>
    <Color x:Key="DynamicCardBackground">#F5F5F5</Color>
    <Color x:Key="DynamicCardBorder">#E8E8E8</Color>

    <!-- Brushes for Dynamic Resources -->
    <SolidColorBrush x:Key="DynamicPrimaryBrush" Color="{DynamicResource DynamicPrimary}"/>
    <SolidColorBrush x:Key="DynamicSecondaryBrush" Color="{DynamicResource DynamicSecondary}"/>
    <SolidColorBrush x:Key="DynamicAccentBrush" Color="{DynamicResource DynamicAccent}"/>
    <SolidColorBrush x:Key="DynamicBackgroundBrush" Color="{DynamicResource DynamicBackground}"/>
    <SolidColorBrush x:Key="DynamicTextBrush" Color="{DynamicResource DynamicText}"/>
    <SolidColorBrush x:Key="DynamicCardBackgroundBrush" Color="{DynamicResource DynamicCardBackground}"/>
    <SolidColorBrush x:Key="DynamicCardBorderBrush" Color="{DynamicResource DynamicCardBorder}"/>

</ResourceDictionary>